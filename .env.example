# Copie para .env (local) e cadastre as mesmas variáveis no painel da Vercel.

# Credenciais do app oficial Cardápio+ USP. Não são públicas: extraia do APK oficial
# (veja a engenharia reversa descrita no README) ou peça a quem mantém o projeto.
USP_MENU_HASH=
USP_DEV_KEY=

# OAuth 1.0a do app oficial (consumer key/secret). Reservado para login via USP; não usado hoje.
USP_OAUTH_CONSUMER_KEY=
USP_OAUTH_CONSUMER_SECRET=

# Painel /admin — senha com pelo menos 8 caracteres e um segredo aleatório longo.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Redis (Upstash, pelo Marketplace da Vercel). Sem isso, estatísticas e avaliações não persistem.
KV_REST_API_URL=
KV_REST_API_TOKEN=
